# Salin menjadi .env lalu isi. Jangan commit file .env.
NODE_ENV=development
PORT=3000

# Connection string Neon PostgreSQL (atau Postgres lokal).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# SSL otomatis aktif saat NODE_ENV=production. Isi false untuk Postgres lokal tanpa SSL.
# DATABASE_SSL=false

# Wajib 32+ karakter acak pada production. Contoh membuat: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=28800

# Origin frontend yang boleh memanggil API (pisahkan dengan koma).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Email dengan domain ini otomatis dianggap mahasiswa UKWMS terverifikasi saat mendaftar.
UKWMS_EMAIL_DOMAINS=student.ukwms.ac.id

# Dipakai oleh `npm run db:seed` untuk membuat akun admin pertama.
ADMIN_NAME=Admin EventKu
ADMIN_EMAIL=
ADMIN_PASSWORD=
# SEED_DEMO=true  # tambahkan contoh organisasi, akun, dan event
