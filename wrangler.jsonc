{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uas-projek-rpl-eventku",
  "main": "backend/src/worker.js",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "iconv-lite": "./backend/src/lib/iconvWorkerShim.js",
    "swagger-ui-express": "./backend/src/lib/noopWorkerShim.js",
    "yaml": "./backend/src/lib/noopWorkerShim.js"
  },
  "assets": {
    "directory": "./frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true
  }
}
